# Run the 2D placement algorithm and return the cargo plan.
#
# Requires a prior call to set_container_occupancy_grid and set_cargo_list.
# Returns one CargoPlacement per cargo unit that could be placed, and the IDs of cargo units that
# did not fit.
---
cargo_planner_msgs/CargoPlacement[] placements  # placed cargo units with 3D center poses
string[]                            no_placed   # IDs of cargo units that did not fit
float64                              placed_area_m2
float64                              free_area_m2
float64                              total_area_m2
float64                              utilization_pct
