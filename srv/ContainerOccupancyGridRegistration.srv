# Store the occupancy grid of the container interior.
#
# The node caches the grid and uses it on the next cargo_planning call.
# The grid must be expressed in container_frame (see README.md file for coordinate conventions).
#
# Container physical dimensions are inferred from the grid metadata:
#  container_length = grid_map.info.width  * grid_map.info.resolution
#  container_width  = grid_map.info.height * grid_map.info.resolution
#
# container_height is required because it is not encoded in the OccupancyGrid.
# container_height must be positive and finite.

nav_msgs/OccupancyGrid grid_map          # container grid, where 0 is free and 100 is occupied
float64                container_height  # positive finite container interior height [m]
---
bool   success
string message
