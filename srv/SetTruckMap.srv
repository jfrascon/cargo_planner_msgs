# SetTruckMap.srv — Store the occupancy grid of the truck interior.
#
# The node caches the grid and uses it on the next plan_cargo call.
# The grid must be in truck_frame (origin at door / right-wall corner,
# X = door → back wall, Y = right wall → left wall).
#
# Truck physical dimensions are inferred from the grid metadata:
#   truck_length = grid_map.info.width  * grid_map.info.resolution
#   truck_width  = grid_map.info.height * grid_map.info.resolution
#
# truck_height is passed explicitly because it is not encoded in the
# OccupancyGrid and is needed to compute the 3D output poses (z-center).

nav_msgs/OccupancyGrid grid_map      # truck interior grid (0 = free, 100 = occupied)
float64                truck_height  # trailer interior height [m] (floor to ceiling)
---
bool   success
string message
