# Asynchronous 2D cargo placement planning.
#
# The caller sends an empty goal. The planner reads the container occupancy grid
# and cargo list that were previously stored via
# container_occupancy_grid_registration and cargo_list_registration.
# The action server accepts the goal, immediately publishes a "computing..."
# feedback message, runs the placement algorithm in a background thread, and
# returns the full cargo plan when done.
#
# Preconditions checked when goal execution begins:
#   - container_occupancy_grid_registration must have been called at least once.
#   - cargo_list_registration must have been called at least once.
#
# If either precondition is not met the goal is aborted with success=false and
# a descriptive message.

# Empty: the planner uses state already stored via
# container_occupancy_grid_registration and cargo_list_registration. No
# per-invocation configuration is needed.
---

# Result
bool     success         # false for a precondition, cancellation, or planning error
string   message         # human-readable status or error description

cargo_planner_msgs/CargoPlacement[] placements   # cargo units that were placed
string[]                            no_placed    # IDs of cargo units that did not fit

float64  placed_area_m2   # total footprint area of placed cargo units [m²]
float64  free_area_m2     # remaining usable grid area after margins and placements [m²]
float64  total_area_m2    # complete rectangular OccupancyGrid area [m²]
float64  utilization_pct  # placed_area_m2 / total_area_m2 * 100 [%]
---

# Feedback
string  status        # human-readable computation status
uint32  cargo_placed  # placed count, zero while computing and final count when complete
uint32  cargo_total   # total number of cargo units in the list
