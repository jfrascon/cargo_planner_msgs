<?xml version="1.0"?>
<package format="3">
  <name>cargo_planner_msgs</name>
  <version>0.1.0</version>
  <description>
    ROS 2 messages and services for the cargo_planner package.
    Defines the data model for pallet dimensions, placement results,
    and the three service interfaces: SetTruckMap, SetPalletList, PlanCargo.
  </description>
  <maintainer email="user@example.com">cargo_planner</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
